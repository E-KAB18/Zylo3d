# --- Exsit Template Environment Variables --- 

# The public URL of your website (used for SEO & Robots.txt) 
NEXT_PUBLIC_SITE_URL=

# Your Backend API URL 
NEXT_PUBLIC_API_URL=

# Google Analytics / GTM IDs (Leave blank if not used) 
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=

# --- Stripe Buy Now Link ---
NEXT_PUBLIC_STRIPE_BUY_URL=

# --- KOL testimonial reel (YouTube video ID, e.g. dQw4w9WgXcQ from youtube.com/watch?v=dQw4w9WgXcQ) ---
NEXT_PUBLIC_KOL_TESTIMONIAL_VIDEO_ID=

# --- Contact Form (Resend) ---
# Get your API key from https://resend.com → API Keys
RESEND_API_KEY=
# The inbox that receives contact form submissions
CONTACT_EMAIL=